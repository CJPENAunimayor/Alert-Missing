{
  "name": "alert-missing-api",
  "version": "1.0.0",
  "description": "Backend API REST sin estado y Worker de notificaciones para Alert Missing (Colombia)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker:dev": "nodemon src/jobs/notificationWorker.js",
    "worker:start": "node src/jobs/notificationWorker.js",
    "db:verify": "node supabase/verify-supabase.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
