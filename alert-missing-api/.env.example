# ==============================================================================
# Alert Missing API - Variables de entorno (.env.example)
# Copiar este archivo como ".env" y completar los valores reales.
# ==============================================================================

# Entorno y servidor HTTP
NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Autenticación y seguridad (JWT + bcrypt)
JWT_SECRET=reemplazar_con_clave_secreta_segura_minimo_32_caracteres
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10

# Supabase Cloud (PostgreSQL + PostGIS, Auth y Storage)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key
SUPABASE_JWT_SECRET=tu_supabase_jwt_secret_opcional
SUPABASE_STORAGE_BUCKET=alert-photos

# OneSignal (Notificaciones Push vía Cola + Worker)
ONESIGNAL_APP_ID=tu_onesignal_app_id
ONESIGNAL_REST_API_KEY=tu_onesignal_rest_api_key
ONESIGNAL_API_URL=https://api.onesignal.com/notifications

# Configuración del Worker asíncrono de notificaciones
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_MAX_RETRIES=3

# Correo electrónico (Nodemailer / SMTP)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@alertmissing.co
SMTP_PASS=tu_contrasena_smtp
MAIL_FROM="Alert Missing <notificaciones@alertmissing.co>"

# Adaptador SMS alterno (opcional)
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=AlertMissing

# Plazo obligatorio SIRDEC (en días hábiles de Colombia)
SIRDEC_PLAZO_DIAS_HABILES=1
SIRDEC_CHECK_INTERVAL_MS=300000
