# ==============================================================================
# Alert Missing Web (PWA) - Variables de entorno (.env.example)
# Copiar este archivo como ".env" y completar los valores reales.
# Todas las variables expuestas al navegador en Vite deben iniciar con VITE_.
# ==============================================================================

# URL base del Backend API REST
VITE_API_BASE_URL=http://localhost:4000/api

# Supabase Cloud (Auth y Storage cliente)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# OneSignal (Web Push para PWA)
VITE_ONESIGNAL_APP_ID=tu_onesignal_app_id

# Configuración inicial de mapa Leaflet (Colombia)
VITE_MAP_DEFAULT_LAT=4.7110
VITE_MAP_DEFAULT_LNG=-74.0721
VITE_MAP_DEFAULT_ZOOM=6
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
